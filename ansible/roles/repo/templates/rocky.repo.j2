[baseos]
name=Rocky Linux $releasever - BaseOS
baseurl=https://dl.rockylinux.org/vault/rocky/{{ current_rocky_version }}/BaseOS/$basearch/os/
gpgcheck=1
enabled=1
countme=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9

[appstream]
name=Rocky Linux $releasever - AppStream
baseurl=https://dl.rockylinux.org/vault/rocky/{{ current_rocky_version }}/AppStream/$basearch/os/
gpgcheck=1
enabled=1
countme=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9

[extras]
name=Rocky Linux $releasever - Extras
baseurl=https://dl.rockylinux.org/vault/rocky/{{ current_rocky_version }}/extras/$basearch/os/
gpgcheck=1
enabled=1
countme=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9
