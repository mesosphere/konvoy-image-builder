#!/bin/bash
set -euo pipefail

# When yum operates on multiple packages, it does not, by default, return an error if a subset
# of packages is not found. This makes yum return an error.
echo skip_missing_names_on_install=False >> /etc/yum.conf

yum -y install epel-release gettext yum-utils createrepo dnf-utils
yum -y upgrade rocky-repos rocky-release rocky-gpg-keys
yum clean all
TMP_DIR="$(mktemp -d repodata-XXXX)"
chmod 777 -R "${TMP_DIR}"
cp packages.txt "${TMP_DIR}"
pushd "${TMP_DIR}"
mapfile -t raw_pkgs < packages.txt
pkgs=()
for p in "${raw_pkgs[@]}"; do
  # Ignore empty/comment lines from templated package lists.
  [[ -z "${p//[[:space:]]/}" || "${p}" =~ ^[[:space:]]*# ]] && continue
  pkgs+=("${p}")
done
bare_pkgs=()
for p in "${pkgs[@]}"; do
  bare_pkgs+=("${p%% *}")
done
repoquery --enablerepo=security --archlist=x86_64,noarch --resolve --requires --recursive "${bare_pkgs[@]}" \
  | xargs -r yumdownloader --enablerepo=security --archlist=x86_64,noarch -x '*i686'
yumdownloader --enablerepo=security --archlist=x86_64,noarch -x '*i686' "${pkgs[@]}"
rm packages.txt
curl https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_amd64/amazon-ssm-agent.rpm -o amazon-ssm-agent.rpm
createrepo -v . && chown -R 1000:1000 repodata/ && chmod -R a+rwX repodata/
#shellcheck disable=SC1083,SC2035
tar -czf {{ .OutputDirectory }}/{{ .KubernetesVersion }}_rocky_9.8_x86_64.tar.gz *
#shellcheck disable=SC1083
chmod 777 {{ .OutputDirectory }}/{{ .KubernetesVersion }}_rocky_9.8_x86_64.tar.gz
popd
rm -rf "${TMP_DIR}"
